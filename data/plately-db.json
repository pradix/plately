      "importedRecipes": [
        {
          "id": "recipe-1777799702005",
          "title": "Rijstroerbak met groente, gemarineerd varkensvlees en satésaus",
          "description": "Roerbakken blijft favoriet! Wat heb je nodig? Rijst, groente en vlees.",
          "time": "20 min",
          "kcal": "680 kcal",
          "servings": "4 Pers.",
          "mealTag": "Avond",
          "sourceUrl": "https://www.ah.nl/allerhande/recept/R-R1191380/rijstroerbak-met-groente-gemarineerd-varkensvlees-en-satesaus",
          "image": "https://static.ah.nl/static/recepten/img_118602_1224x900_JPG.jpg",
          "alt": "Rijstroerbak met groente, gemarineerd varkensvlees en satésaus",
          "platform": "website",
          "caption": "Roerbakken blijft favoriet! Wat heb je nodig? Rijst, groente en vlees.",
          "author": "Albert Heijn",
          "ingredients": [
            {
              "quantity": "325",
              "unit": "g",
              "name": "gele rijst"
            },
            {
              "quantity": "500",
              "unit": "g",
              "name": "magere varkenslappen"
            },
            {
              "quantity": "3",
              "unit": "el",
              "name": "Conimex ketjap manis"
            },
            {
              "quantity": "1",
              "unit": "el",
              "name": "vloeibare honing"
            },
            {
              "quantity": "2",
              "unit": "el",
              "name": "arachideolie"
            },
            {
              "quantity": "400",
              "unit": "g",
              "name": "Conimex pindasaus mild in pot"
            },
            {
              "quantity": "400",
              "unit": "g",
              "name": "Thaise wokgroente"
            },
            {
              "quantity": "1",
              "unit": "x",
              "name": "komkommer"
            }
          ],
          "instructions": [
            "Kook de rijst volgens de aanwijzingen op de verpakking. Giet af en laat met de deksel op de pan staan tot gebruik.",
            "Snijd de hamlappen in stukken van 2 cm en meng met ⅔ van de ketjap en de honing. Verhit de helft van de olie in een koekenpan en bak het vlees in 3 min. rondom bruin. Voeg de pindasaus toe en verwarm nog 5 min. op laag vuur.",
            "Verhit ondertussen de rest van de olie in een wok en bak de Thaise wokgroente en de rest van de ketjap 5 min. Voeg de rijst toe en warm 1 min. mee.",
            "Halveer de komkommer in de lengte en snijd in schuine halve plakjes. Serveer de rijstroerbak met de saté en komkommer."
          ],
          "isSeed": false
        },
        {
          "id": "recipe-1777799674598",
          "title": "Gebakken aardappel met slavink en crispy chili-jus",
          "description": "Geef de klassieke slavink een verrassende twist met pittige crispy chili-jus, knapperige aardappelschijfjes uit de oven en geroosterde bimi – een comfortfood-recept vol smaak en pit.",
          "time": "70 min",
          "kcal": "1105 kcal",
          "servings": "4 Pers.",
          "mealTag": "Avond",
          "sourceUrl": "https://www.ah.nl/allerhande/recept/R-R1202416/gebakken-aardappel-met-slavink-en-crispy-chili-jus",
          "image": "https://static.ah.nl/static/recepten/img_RAM_PRD218658_1224x900_JPG.jpg",
          "alt": "Gebakken aardappel met slavink en crispy chili-jus",
          "platform": "website",
          "caption": "Geef de klassieke slavink een verrassende twist met pittige crispy chili-jus, knapperige aardappelschijfjes uit de oven en geroosterde bimi – een comfortfood-recept vol smaak en pit.",
          "author": "Albert Heijn",
          "ingredients": [
            {
              "quantity": "800",
              "unit": "g",
              "name": "koelverse aardappelschijfjes"
            },
            {
              "quantity": "4",
              "unit": "el",
              "name": "milde olijfolie"
            },
            {
              "quantity": "400",
              "unit": "g",
              "name": "bimi"
            },
            {
              "quantity": "2",
              "unit": "tenen",
              "name": "knoflook"
            },
            {
              "quantity": "300",
              "unit": "g",
              "name": "gemengd gehakt"
            },
            {
              "quantity": "50",
              "unit": "g",
              "name": "paneermeel"
            },
            {
              "quantity": "1",
              "unit": "x",
              "name": "scharrelei"
            },
            {
              "quantity": "12",
              "unit": "x",
              "name": "plakken ontbijtspek"
            },
            {
              "quantity": "20",
              "unit": "g",
              "name": "ongezouten roomboter"
            },
            {
              "quantity": "2",
              "unit": "x",
              "name": "uien"
            },
            {
              "quantity": "2",
              "unit": "tl",
              "name": "tarwebloem"
            },
            {
              "quantity": "200",
              "unit": "ml",
              "name": "water"
            },
            {
              "quantity": "1",
              "unit": "el",
              "name": "crispy chili in oil"
            }
          ],
          "instructions": [
            "Verwarm de oven voor op 200 °C. Verdeel de aardappelschijfjes over een met bakpapier beklede bakplaat, schep om met ¾ van de olie en breng op smaak met peper en eventueel zout. Bak ca. 40 min. in de oven. Haal na 25 min. uit de oven, leg de bimi ernaast, verlaag de temperatuur naar 180 °C en bak de bimi 15 min. mee.",
            "Snijd ondertussen de knoflook fijn en meng met het gehakt, paneermeel en ei. Breng op smaak met peper en eventueel zout en vorm er 4 slavinkvormen (per 4 personen) van 7 cm lang van.",
            "Leg twee plakken ontbijtspek verticaal naast elkaar en leg er een derde horizontaal aan de bovenkant op. Rol elke slavink in 3 plakken ontbijtspek.",
            "Verhit de rest van de olie en de boter in een koekenpan op middelhoog vuur. Bak de slavinken in 8 min. rondom aan. Snijd ondertussen de uien in halve ringen. Haal de slavinken uit de pan. Bak de uien 10 min. in het achtergebleven bakvet op middelhoog vuur. Roer regelmatig. Zeef de bloem boven de pan en voeg het water en de crispy chili oil toe. Roer goed met een garde en leg de slavinken erbij. Laat 15 min. doorgaren, keer af en toe. Serveer de slavinken met de bimi, aardappelen en crispy chili-jus."
          ],
          "isSeed": false
        },
        {
          "id": "recipe-1777615440300",
          "title": "Spaghetti met kipgehaktballetjes in tomatensaus",
          "description": "Zet vanavond in 25 minuten de Italiaanse zon op tafel! Deze spaghetti met sappige kipgehaktballetjes in kruidige tomatensaus, verse basilicum en volkorenpasta is perfect voor een lekkere en voedzame op een doordeweekse avond.",
          "time": "25 min",
          "kcal": "935 kcal",
          "servings": "4 Pers.",
          "mealTag": "Avond",
          "sourceUrl": "https://www.ah.nl/allerhande/recept/R-R1202279/spaghetti-met-kipgehaktballetjes-in-tomatensaus",
          "image": "https://static.ah.nl/static/recepten/img_RAM_PRD218442_1024x748_JPG.jpg",
          "alt": "Spaghetti met kipgehaktballetjes in tomatensaus",
          "platform": "website",
          "caption": "Zet vanavond in 25 minuten de Italiaanse zon op tafel! Deze spaghetti met sappige kipgehaktballetjes in kruidige tomatensaus, verse basilicum en volkorenpasta is perfect voor een lekkere en voedzame op een doordeweekse avond.",
          "author": "Albert Heijn",
          "ingredients": [
            {
              "quantity": "3",
              "unit": "x",
              "name": "uien"
            },
            {
              "quantity": "4",
              "unit": "x",
              "name": "tenen knoflook"
            },
            {
              "quantity": "15",
              "unit": "g",
              "name": "verse platte peterselie"
            },
            {
              "quantity": "300",
              "unit": "g",
              "name": "kipgehakt naturel"
            },
            {
              "quantity": "1",
              "unit": "x",
              "name": "scharrelei"
            },
            {
              "quantity": "1",
              "unit": "tl",
              "name": "chilivlokken"
            },
            {
              "quantity": "15",
              "unit": "g",
              "name": "verse basilicum"
            },
            {
              "quantity": "5",
              "unit": "el",
              "name": "milde olijfolie"
            },
            {
              "quantity": "2",
              "unit": "tl",
              "name": "gedroogde oregano"
            },
            {
              "quantity": "800",
              "unit": "g",
              "name": "polpa in blik"
            },
            {
              "quantity": "300",
              "unit": "g",
              "name": "volkoren spaghetti"
            }
          ],
          "instructions": [
            "Snipper de uien. Snijd de knoflook en peterselie fijn. Meng de helft van de ui en de helft van de knoflook met de peterselie, het kipgehakt, ei en de chilivlokken. Breng op smaak met peper en eventueel zout en meng goed. Vorm er 12 balletjes (per 4 personen) van en zet in de koelkast tot gebruik.",
            "Pluk de blaadjes van het basilicum en snijd de steeltjes fijn. Verhit de helft van de olie in een grote hapjespan op middelhoog vuur en bak de rest van de ui en knoflook met de baslicumsteeltjes en oregano 5 min. Voeg de polpa toe, breng op smaak met peper en eventueel zout en breng aan de kook. Laat 10 min. op laag vuur koken. Roer af en toe.",
            "Bereid ondertussen de spaghetti volgens de aanwijzingen op de verpakking. Giet af en bewaar een kopje kookvocht.",
            "Verhit ondertussen de rest van de olie in een koekenpan op middelhoog vuur en bak de gehaktballetjes in 10 min. rondom gaar en lichtbruin. Schep de spaghetti, gehaktballetjes en basilicumblaadjes door de saus. Voeg eventueel extra kookvocht toe als de saus te dik is."
          ],
          "isSeed": false
        },
        {
          "id": "recipe-1777546959641",
          "title": "Beef stroganoff",
          "description": "Beef Stroganoff. Een heerlijk bordje comfort food: mals vlees in een zalige, romige champignonsaus. Een fantastische Russische klassieker!",
          "time": "130 min",
          "kcal": "1105 kcal",
          "servings": "4 Pers.",
          "mealTag": "Avond",
          "sourceUrl": "https://www.eefkooktzo.nl/beef-stroganoff/",
          "image": "https://www.eefkooktzo.nl/wp-content/uploads/2024/02/beef-stroganoff.jpg",
          "alt": "Beef stroganoff",
          "platform": "website",
          "caption": "Beef Stroganoff. Een heerlijk bordje comfort food: mals vlees in een zalige, romige champignonsaus. Een fantastische Russische klassieker!",
          "author": "Eef",
          "ingredients": [
            {
              "quantity": "500",
              "unit": "g",
              "name": "ram runderriblappen (in blokjes)"
            },
            {
              "quantity": "1",
              "unit": "x",
              "name": "rode ui (gesnipperd)"
            },
            {
              "quantity": "2",
              "unit": "teen",
              "name": "tjes knoflook (fijn gesneden)"
            },
            {
              "quantity": "400",
              "unit": "g",
              "name": "ram kastanjechampignons (in plakjes)"
            },
            {
              "quantity": "2",
              "unit": "x",
              "name": "eetlepels bloem"
            },
            {
              "quantity": "250",
              "unit": "ml",
              "name": "runderbouillon"
            },
            {
              "quantity": "70",
              "unit": "g",
              "name": "ram tomatenpuree"
            },
            {
              "quantity": "2",
              "unit": "x",
              "name": "eetlepels dijon mosterd"
            },
            {
              "quantity": "150",
              "unit": "ml",
              "name": "zure room"
            },
            {
              "quantity": "100",
              "unit": "ml",
              "name": "kookroom"
            },
            {
              "quantity": "1",
              "unit": "x",
              "name": "olijfolie, zout en peper"
            },
            {
              "quantity": "1",
              "unit": "x",
              "name": "verse peterselie"
            },
            {
              "quantity": "300",
              "unit": "g",
              "name": "ram basmati rijst"
            }
          ],
          "instructions": [
            "Verhit wat olijfolie in een pan op middelhoog vuur. Bak de blokjes runderriblappen aan alle zijden bruin. Haal ze uit de pan en zet opzij.",
            "Voeg meer olie toe indien nodig en bak de ui en knoflook tot ze zacht zijn. Voeg de champignons toe en bak tot ze bruin zijn.",
            "Strooi de bloem over het champignonmengsel en roer goed door.",
            "Giet langzaam de runderbouillon erbij, blijf roeren om klontjes te voorkomen.",
            "Voeg de tomatenpuree, mosterd, zure room en kookroom toe. Roer tot de saus dikker wordt.",
            "Breng op smaak met zout en peper. Voeg de gebakken runderriblappen toe aan de saus en laat het geheel nog 1,5 tot 2 uur sudderen op laag vuur.",
            "Kook ondertussen de rijst.",
            "Serveer de beef stroganoff met de rijst en garneer optioneel met verse peterselie. Eet smakelijk!"
          ],
          "isSeed": false
        }

# Plately — environment variables
# Copy this file to .env and fill in your keys
#
# Client (statische hosting): zet in index.html de meta’s plately-api-base en desnoods
# plately-share-link-origin — zie commentaar bij die tags. Alleen server-.env is niet genoeg
# voor de browser.

# Deploy-log pagina /deploy-status.html (standaard alleen op beta.plately.nl + niet-productie).
# Zet op 1 om de pagina op elk domein toe te staan, of zie PLATELY_DEPLOY_STATUS_HOSTS.
# PLATELY_DEPLOY_STATUS_PAGE=
# Komma-gescheiden hostnames (bijv. je Render-URL host) naast beta.plately.nl:
# PLATELY_DEPLOY_STATUS_HOSTS=plately-xxx.onrender.com
# GitHub repo voor commit-links (default pradix/plately):
# PLATELY_SOURCE_REPO=pradix/plately

# Optional but recommended in production
NODE_ENV=development
# JSON-opslag (sessions, shareLinks, …). Op Render het liefst persistent disk mount op /data.
# Zonder mount probeert Plately automatisch ./data onder de app-root en daarna een map onder het OS-tmp.
# Logs: zoek naar evt "plately_import_failed", "plately_share_created".
DATA_DIR=./data

# Optional for real accounts + sync across devices
# If empty, Plately falls back to guest sessions with JSON storage
DATABASE_URL=

# Sign in with Apple (alleen samen met DATABASE_URL / Postgres)
# Apple Developer: maak een Services ID (bv. nl.plately.web) met “Sign in with Apple”,
# koppel die aan je App ID, en zet Return URLs exact gelijk aan APPLE_REDIRECT_URI (of de site-root).
# Als de frontend op een ander domein draait dan de API, zet APPLE_REDIRECT_URI expliciet op de
# publieke origin van de pagina waar de inlogknop staat (inclusief trailing slash als in Apple).
APPLE_CLIENT_ID=
APPLE_REDIRECT_URI=

# Anthropic API key — enables Claude-powered recipe extraction (much better titles + steps)
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Google Serper API — set this in production if you want kanaalzoek for Miljuschka / Eef Kookt Zo
# (their sites return 403 / Cloudflare for server datacenter IPs; direct fetch + Jina cannot read them).
# Get a key at https://serper.dev/
SERPER_API_KEY=
# Alternative name (either works):
# PLATELY_SERP_API_KEY=

# ZenRows — optionele Cloudflare-bypass voor importeren van sites die datacenter-IPs blokkeren (bv. Miljuschka, Eef Kookt Zo).
# Werkt ook voor andere geblokkeerde sites. Gratis: 1000 credits/mnd. Betaald vanaf $49/mnd.
# Aanmaken via https://www.zenrows.com/
ZENROWS_API_KEY=

# Meta credentials — only needed for Instagram import
META_APP_ID=
META_APP_SECRET=

# Web Push (PWA)
# Generate with: npm run gen:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Recommended: mailto:... or https://...
VAPID_SUBJECT=mailto:you@example.com
